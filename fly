-- ---------------------------------------------------------------------
-- GUI Parent Resolver (Prioritize CoreGui)
-- ---------------------------------------------------------------------
local function getGuiContainer()
    local container = nil
    if gethui then
        pcall(function() container = gethui() end)
    end
    if not container then
        pcall(function() container = CoreGui end)
    end
    if not container then
        pcall(function() container = game:GetService("RobloxGui") end)
    end
    if not container then
        container = LocalPlayer:WaitForChild("PlayerGui")
    end
    return container
end

