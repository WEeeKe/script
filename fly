-- ---------------------------------------------------------------------
-- Keybind Rebinding Handlers
-- ---------------------------------------------------------------------
local function cancelBinding()
    if bindingBtn then
        if bindingTarget == "Fly" then
            bindingBtn.Text = formatKeyName(flyKey)
        elseif bindingTarget == "Up" then
            bindingBtn.Text = formatKeyName(upKey)
        elseif bindingTarget == "Down" then
            bindingBtn.Text = formatKeyName(downKey)
        end
        bindingBtn.TextColor3 = Color3.fromRGB(170, 170, 170)
    end
    bindingTarget = nil
    bindingBtn = nil
end

local function applyBinding(newKey)
    if not bindingTarget or not bindingBtn then return end

    if bindingTarget == "Fly" then
        flyKey = newKey
        bindingBtn.Text = formatKeyName(flyKey)
    elseif bindingTarget == "Up" then
        upKey = newKey
        bindingBtn.Text = formatKeyName(upKey)
    elseif bindingTarget == "Down" then
        downKey = newKey
        bindingBtn.Text = formatKeyName(downKey)
    end

    bindingBtn.TextColor3 = Color3.fromRGB(170, 170, 170)
    bindingTarget = nil
    bindingBtn = nil
end

local function startRebinding(targetName, btn)
    if bindingTarget then
        cancelBinding()
    end
    bindingTarget = targetName
    bindingBtn = btn
    btn.Text = "[...]"
    btn.TextColor3 = Color3.fromRGB(90, 200, 255)
end

