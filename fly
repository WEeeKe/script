local function setSpeed(val)
    val = math.clamp(math.round(val * 10) / 10, minSpeed, maxSpeed)
    flySpeed = val
    speedValueLabel.Text = string.format("%.1f", flySpeed)

    local alpha = math.clamp((flySpeed - minSpeed) / (maxSpeed - minSpeed), 0, 1)
    sliderFill.Size = UDim2.new(alpha, 0, 1, 0)
    sliderThumb.Position = UDim2.new(alpha, 0, 0.5, 0)
end

-- Slider Dragging
local sliderDragging = false

local function updateSlider(input)
    local trackPos = sliderTrack.AbsolutePosition.X
    local trackSize = sliderTrack.AbsoluteSize.X
    local mousePos = input.Position.X
    local relative = math.clamp((mousePos - trackPos) / trackSize, 0, 1)
    local calculated = minSpeed + (relative * (maxSpeed - minSpeed))
    setSpeed(calculated)
end

sliderHitbox.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        updateSlider(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSlider(input)
    end
end)

